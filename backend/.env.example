# Copia este archivo como ".env" y completa los valores. NUNCA subas ".env" a GitHub.

# Puerto local (en Render lo asigna la plataforma automáticamente)
PORT=3000

# local = development | en Render = production
NODE_ENV=development

# Cadena de conexión de MongoDB Atlas (incluye el nombre de la base: huellas_vivas)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/huellas_vivas?retryWrites=true&w=majority

# Texto largo y aleatorio (mínimo 32 caracteres) para firmar los tokens JWT
JWT_SECRET=cambia-este-texto-por-uno-largo-y-aleatorio-123456
JWT_EXPIRES_IN=8h

# Dominios del frontend autorizados (separados por coma, sin "/" final)
CORS_ORIGIN=http://localhost:5173

# Contraseña que tendrán los usuarios de prueba creados por "npm run cargar-datos"
CLAVE_DE_PRUEBA=Huellas2026!
